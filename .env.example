# Copy this file to `.env` (which is git-ignored) before running `docker compose up`.
#
# These values intentionally match Precept.Api/appsettings.Development.json so a
# locally-run backend (`dotnet run`) connects to the containerized Postgres on
# localhost:5432 with no further configuration. Change them for production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=precept_db

# Must be at least 32 bytes for HMAC-SHA256. Replace with a strong secret in production.
JWT_SECRET_KEY=dev-only-not-for-production-must-be-at-least-32-bytes-long-for-hmac-sha256

# Comma-separated host allow-list, or * for any. Restrict this in production.
ALLOWED_HOSTS=*

# Comma-separated list of allowed CORS origins for the Production policy.
# Required in production so the frontend can send credentials across origins.
# Example: CORS_ORIGINS=https://app.precept.dev,https://www.precept.dev
CORS_ORIGINS=

# Resend API Key for transactional and follow-up emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=coach@precept.app

# Optional SMTP configuration (fallback for email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=coach@precept.app

# AI / LLM Configuration (Vendor-Agnostic)
# Provider options: "Auto", "OpenAI", "Claude", "Gemini", "Groq", "DeepSeek", "Ollama", or "Custom"
AI_PROVIDER=Auto

# Model name of your choice (e.g. gpt-4o-mini, gemini-1.5-flash, claude-3-5-haiku-20241022, deepseek-chat, llama-3.3-70b-versatile)
AI_MODEL=gpt-4o-mini

# Primary API Key or provider-specific keys
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Custom endpoint (for Ollama, vLLM, Groq, DeepSeek, or OpenRouter)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_BASE_URL=http://localhost:11434/v1
AI_BASE_URL=

